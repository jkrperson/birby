# Local dev: embedded PGlite Postgres, no setup needed.
DATABASE_URL=pglite://./.pglite
# Production: Neon (or any Postgres reachable over Neon's serverless driver)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# GitHub OAuth app — create at https://github.com/settings/developers
# Callback URL: <base url>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Where this app is served (share links, OG images, /birby:link URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Only when serving through a reverse proxy / tunnel (e.g. Tailscale Serve):
# AUTH_URL=https://your-host.example.com
# AUTH_TRUST_HOST=true
